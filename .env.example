# ============================================================================
# Rakt Sanchar — Local Environment Example (.env.example)
# Copy to .env for local overrides. Never commit real secrets or .env files.
# ============================================================================

# --- Backend settings (Server-side only) ---
SERVER_PORT=9090
SPRING_PROFILES_ACTIVE=demo
FRONTEND_ORIGIN=http://localhost:5173

# Eligibility & matching rules (optional overrides)
APP_ELIGIBILITY_MIN_AGE=18
APP_ELIGIBILITY_MAX_AGE=65
APP_ELIGIBILITY_MIN_GAP_DAYS=90
APP_MATCHING_DEFAULT_RADIUS_KM=25.0

# Demo admin identity (used only under 'demo' profile; no real credentials)
APP_DEMO_ADMIN_USER_ID=demo-admin-1
APP_DEMO_ADMIN_NAME=Rakt Sanchar Demo Admin

# --- Frontend settings (Browser-visible — NEVER put secrets in VITE_* vars) ---
VITE_API_URL=http://localhost:9090
